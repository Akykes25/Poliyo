:root {
    --ink: #11242f;
    --ink-soft: #193846;
    --surface: #234858;
    --surface-light: #2d596a;
    --accent: #f0a23b;
    --text: #f7f3e8;
    --muted: #afc1c8;
    --line: #477080;
}

.campaign-shell { width: 100%; height: 100%; background-color: var(--ink); color: var(--text); }
.header, .navigation-bar, .header-status, .action-bar, .news-ticker, .activity-row { flex-direction: row; align-items: center; }
.header { justify-content: space-between; padding: 18px 28px; background-color: var(--surface); border-bottom-width: 1px; border-color: var(--line); }
.brand { font-size: 30px; -unity-font-style: bold; color: var(--accent); }
.header-item { color: var(--muted); font-size: 14px; margin-left: 16px; }
.navigation-bar { padding: 9px 28px; background-color: var(--surface-light); }
.nav-spacer { flex-grow: 1; }
.nav-button, .press-button { color: var(--text); background-color: #00000000; border-width: 0; margin-right: 12px; }
.territory-label { color: var(--muted); font-size: 12px; margin-right: 14px; }
.press-button { margin-right: 0; border-width: 1px; border-color: var(--accent); border-radius: 6px; padding: 6px 14px; color: var(--accent); }
.content-area { flex-grow: 1; flex-direction: row; padding: 24px 28px; }
.workspace-panel, .national-summary { background-color: var(--surface); border-radius: 10px; padding: 24px; }
.workspace-panel { flex-grow: 1; margin-right: 18px; }
.national-summary { width: 300px; }
.screen-title { font-size: 28px; -unity-font-style: bold; color: var(--text); }
.screen-description, .summary-description { margin-top: 8px; color: var(--muted); font-size: 16px; white-space: normal; }
.status-message { margin-top: 18px; color: var(--text); white-space: normal; }
.context-content { flex-grow: 1; min-height: 120px; margin-top: 14px; }
.context-card { margin-bottom: 10px; padding: 12px; background-color: var(--ink-soft); border-radius: 7px; border-left-width: 3px; border-color: var(--accent); }
.context-card-title { color: var(--accent); -unity-font-style: bold; font-size: 15px; }
.context-card-copy { margin-top: 5px; color: var(--muted); white-space: normal; }
.locality-button { margin-top: 7px; background-color: var(--surface-light); color: var(--text); border-width: 1px; border-color: var(--line); border-radius: 5px; padding: 6px 10px; -unity-text-align: middle-left; }
.locality-button:hover { border-color: var(--accent); color: var(--accent); }
.panel-title { font-size: 17px; -unity-font-style: bold; color: var(--accent); }
.summary-value { margin-top: 20px; font-size: 20px; -unity-font-style: bold; }
.news-ticker { min-height: 46px; padding: 0 28px; background-color: #10212a; border-top-width: 1px; border-color: var(--line); }
.news-label { color: var(--accent); -unity-font-style: bold; margin-right: 16px; }
.news-headline { color: var(--muted); }
.action-bar { justify-content: space-between; padding: 14px 28px; background-color: var(--surface); }
.phase-label { color: var(--muted); }
.next-day-button { background-color: var(--accent); color: #182833; -unity-font-style: bold; border-radius: 8px; padding: 10px 18px; }
.activity-row { margin-top: 14px; }
.activity-button { margin-right: 10px; background-color: var(--surface-light); color: var(--text); border-width: 1px; border-color: var(--line); border-radius: 6px; padding: 8px 14px; }
.activity-button:hover { border-color: var(--accent); color: var(--accent); }